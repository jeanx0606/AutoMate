{
  "name": "autologin",
  "version": "1.0.0",
  "description": "AutoMate - 网页认证自动登录助手",
  "main": "main.js",
  "author": "AutoMate",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build && cross-env NODE_ENV=production electron .",
    "build:renderer": "vite build",
    "test": "node --test",
    "dist": "vite build && electron-builder",
    "lint": "echo \"No linter configured\" && exit 0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "electron-store": "^7.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.automate.autologin",
    "productName": "AutoMate",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
